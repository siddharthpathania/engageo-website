# ==============================================================================
# Engageo — Environment Variables
# Copy to .env.local and fill in real values before deploying.
# ==============================================================================

# ── Public (exposed to browser) ──────────────────────────────────────────────

# Canonical URL — used by sitemap, OG tags, canonical links, structured data.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.engageoagency.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console verification meta tag content
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Server-only (NEVER exposed to browser) ───────────────────────────────────

# Resend API key — for sending contact-form notification emails.
# Sign up at https://resend.com
RESEND_API_KEY=

# Email address that receives contact form submissions.
CONTACT_FORM_TO=hello@engageoagency.com

# Contact form rate-limit: max submissions per IP per hour. Default: 5.
CONTACT_RATE_LIMIT=5
