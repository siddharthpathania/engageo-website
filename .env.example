# ==============================================================================
# Engageo — Environment Variables
# Copy to .env.local and fill in real values before deploying.
# ==============================================================================

# ── Public (exposed to browser) ──────────────────────────────────────────────

# Canonical URL — used by sitemap, OG tags, canonical links, structured data.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.engageoagency.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID (optional — defaults to the live project in code)
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console verification meta tag content
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Server-only (NEVER exposed to browser) ───────────────────────────────────

# Resend API key — for sending contact-form notification emails.
# Sign up at https://resend.com
RESEND_API_KEY=

# Email address that receives contact form submissions.
CONTACT_FORM_TO=engageoagency@gmail.com

# Contact form rate-limit: max submissions per IP per hour. Default: 5.
CONTACT_RATE_LIMIT=5

# ── WhatsApp OTP (Meta WhatsApp Cloud API) ───────────────────────────────────
# Delivers the phone-verification code over WhatsApp on the experience page and
# the lead popup. Without these set, the OTP flow runs in dev-mock mode (the
# code is returned to the browser locally; nothing is sent in production).

# Sender phone number ID from WhatsApp Manager.
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with the whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Name of the approved Authentication (OTP) template.
WHATSAPP_OTP_TEMPLATE_NAME=
# Template language code. Default: en
WHATSAPP_OTP_TEMPLATE_LANG=en
# Graph API version. Default: v21.0
WHATSAPP_API_VERSION=v21.0

# OTP rate limits (per hour). Defaults: 10 per IP, 3 per phone.
OTP_RATE_LIMIT_IP=10
OTP_RATE_LIMIT_PHONE=3
